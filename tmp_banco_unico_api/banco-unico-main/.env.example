PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/banco_unico
DATABASE_SSL=false
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_INTELLIGENT_SEARCH_MODEL=gpt-4o-mini
OPENAI_PRODUCT_RELEVANCE_MODEL=gpt-4o-mini
POSTGRES_DB=banco_unico
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
VECTOR_DIMENSIONS=512
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50
MAX_TOKENS_PER_PRODUCT=256
DEFAULT_INCLUDE_RELEVANCE_SCORE=false
INTEGRATION_REQUEST_TIMEOUT_MS=15000
UPSERT_BATCH_SIZE=1000
MAX_RETURNED_PRODUCTS=100
ALPHA7_API_BASE_URL=
ALPHA7_CONSULTAR_EANS_PATH=/api/consultar-eans
ALPHA7_AUTH_HEADER_NAME=x-api-key
ALPHA7_AUTH_PREFIX=
ALPHA7_TIMEOUT_MS=15000
