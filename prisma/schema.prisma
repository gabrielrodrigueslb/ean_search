generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoProduto {
  medicamento
  perfumaria
  outro
}

enum StatusImportacao {
  pending
  processing
  completed
  failed
}

enum StatusItemImportacao {
  pending
  processing
  enriched
  review_required
  not_found
  failed
}

enum StatusRevisao {
  pending
  approved
  rejected
}

enum StatusEanNaoEncontrado {
  pending_review
  resolved
  discarded
}

model Produto {
  id               Int                 @id @default(autoincrement())
  nome             String
  nome_normalizado String
  slug             String?
  tipo             TipoProduto         @default(outro)
  laboratorio      String?
  laboratorio_slug String?
  classe           String?
  classe_slug      String?
  categoria        String?
  origem_nome      String
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  apresentacoes    Apresentacao[]
  produto_farmacos ProdutoFarmaco[]

  @@map("produtos")
}

model Apresentacao {
  id                 Int        @id @default(autoincrement())
  produto_id         Int
  ean                String     @unique
  descricao          String?
  dose               String?
  unidade            String?
  forma_farmaceutica String?
  via_administracao  String?
  quantidade         String?
  volume             String?
  registro_ms        String?
  tarja              String?
  origem_dados       String
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  produto            Produto    @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@index([produto_id])
  @@map("apresentacoes")
}

model Farmaco {
  id               Int              @id @default(autoincrement())
  nome             String
  nome_normalizado String
  slug             String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  produto_farmacos ProdutoFarmaco[]

  @@unique([nome_normalizado])
  @@map("farmacos")
}

model ProdutoFarmaco {
  id         Int      @id @default(autoincrement())
  produto_id Int
  farmaco_id Int
  created_at DateTime @default(now())
  produto    Produto  @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  farmaco    Farmaco  @relation(fields: [farmaco_id], references: [id], onDelete: Cascade)

  @@unique([produto_id, farmaco_id])
  @@index([produto_id])
  @@index([farmaco_id])
  @@map("produto_farmacos")
}

model Importacao {
  id                Int                  @id @default(autoincrement())
  fonte             String
  status            StatusImportacao     @default(pending)
  total_itens       Int                  @default(0)
  itens_processados Int                  @default(0)
  itens_sucesso     Int                  @default(0)
  itens_falha       Int                  @default(0)
  itens_revisao     Int                  @default(0)
  created_at        DateTime             @default(now())
  finished_at       DateTime?
  itens             ItemImportacao[]

  @@map("importacoes")
}

model ItemImportacao {
  id                Int                 @id @default(autoincrement())
  importacao_id     Int
  ean               String
  nome_recebido     String?
  dados_brutos      String
  status            StatusItemImportacao @default(pending)
  mensagem_erro     String?
  fontes_consultadas String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  importacao        Importacao          @relation(fields: [importacao_id], references: [id], onDelete: Cascade)

  @@index([importacao_id])
  @@index([ean])
  @@map("itens_importacao")
}

model SolicitacaoRevisao {
  id               Int           @id @default(autoincrement())
  entity_type      String
  entity_id        Int?
  ean              String?
  dados_atuais     String
  dados_sugeridos  String
  diff_campos      String
  motivo           String
  resumo_ia        String?
  confidence_score Float?
  fonte            String
  status           StatusRevisao @default(pending)
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([status])
  @@index([ean])
  @@map("solicitacoes_revisao")
}

model EanNaoEncontrado {
  id                  Int                    @id @default(autoincrement())
  ean                 String                 @unique
  nome_recebido       String?
  dados_brutos        String
  fontes_tentadas     String?
  motivo_nao_encontrado String
  status              StatusEanNaoEncontrado @default(pending_review)
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  @@map("eans_nao_encontrados")
}

model HistoricoAlteracao {
  id                     Int      @id @default(autoincrement())
  solicitacao_revisao_id Int
  entity_type            String
  entity_id              Int?
  antes                  String
  depois                 String
  aplicado_por           String?
  created_at             DateTime @default(now())

  @@index([solicitacao_revisao_id])
  @@map("historico_alteracoes")
}
