generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusImportacao {
  pending
  processing
  completed
  failed
}

enum StatusItemImportacao {
  pending
  processing
  enriched
  review
  failed
}

model Importacao {
  id                Int               @id @default(autoincrement())
  fonte             String
  status            StatusImportacao  @default(pending)
  total_itens       Int               @default(0)
  itens_processados Int               @default(0)
  itens_sucesso     Int               @default(0)
  itens_falha       Int               @default(0)
  itens_revisao     Int               @default(0)
  created_at        DateTime          @default(now())
  finished_at       DateTime?
  itens             ItemImportacao[]
  aprovacoes        ProdutoAprovacao[]
  fallbacks         ProdutoFallbackApi[]

  @@map("importacoes")
}

model ItemImportacao {
  id                 Int                  @id @default(autoincrement())
  importacao_id      Int
  ean                String
  nome_recebido      String?
  dados_brutos       String
  status             StatusItemImportacao @default(pending)
  mensagem_erro      String?
  fontes_consultadas String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  importacao         Importacao           @relation(fields: [importacao_id], references: [id], onDelete: Cascade)
  aprovacoes         ProdutoAprovacao[]
  fallbacks          ProdutoFallbackApi[]

  @@index([importacao_id])
  @@index([ean])
  @@map("itens_importacao")
}

model ProdutoAprovacao {
  id                Int            @id @default(autoincrement())
  importacao_id     Int
  item_importacao_id Int?
  ean               String
  nome_sugerido     String?
  motivo            String
  fonte_origem      String?
  dados_brutos      String
  status            String         @default("pending")
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  importacao        Importacao     @relation(fields: [importacao_id], references: [id], onDelete: Cascade)
  item_importacao   ItemImportacao? @relation(fields: [item_importacao_id], references: [id], onDelete: SetNull)

  @@index([importacao_id])
  @@index([item_importacao_id])
  @@index([ean])
  @@map("produtos_aprovacao")
}

model ProdutoFallbackApi {
  id                 Int            @id @default(autoincrement())
  importacao_id      Int
  item_importacao_id Int?
  ean                String
  payload            String
  api_config         String?
  motivo_falha       String
  resposta_erro      String?
  status             String         @default("pending_replay")
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  importacao         Importacao     @relation(fields: [importacao_id], references: [id], onDelete: Cascade)
  item_importacao    ItemImportacao? @relation(fields: [item_importacao_id], references: [id], onDelete: SetNull)

  @@index([importacao_id])
  @@index([item_importacao_id])
  @@index([ean])
  @@index([status])
  @@map("produtos_fallback_api")
}
